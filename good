                noMsg.classList.remove('hidden');
                return;
            }

            noMsg.classList.add('hidden');
            container.innerHTML = items.map(snack => `
                <div class="bg-white rounded-2xl overflow-hidden border border-warm-200/80 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between group">
                    <div>
                        <!-- 圖片區 -->
                        <div class="relative overflow-hidden aspect-[4/3]">
                            <img src="${snack.image}" alt="${snack.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" onerror="this.src='https://placehold.co/600x400/EBE3D5/736043?text=Tasty+Snack'">
                            <span class="absolute top-3 left-3 bg-warm-800/80 backdrop-blur-md text-white text-xs px-2.5 py-1 rounded-full font-medium">
                                ${snack.categoryName}
                            </span>
                            <span class="absolute top-3 right-3 bg-red-500 text-white text-xs font-bold px-2 py-0.5 rounded-md shadow">
                                ${snack.discount}
                            </span>
                        </div>
                        
                        <!-- 內文區 -->
                        <div class="p-5">
                            <h3 class="font-bold text-base text-warm-800 group-hover:text-warm-600 transition-colors line-clamp-1 mb-1">${snack.name}</h3>
                            <div class="mb-3">
                                ${renderStars(snack.rating)}
                            </div>
                            <p class="text-warm-600 text-xs sm:text-sm line-clamp-2 leading-relaxed mb-4">
                                ${snack.description}
                            </p>
                        </div>
                    </div>

                    <!-- 底部價格與購買按鈕 -->
                    <div class="px-5 pb-5 pt-0 flex items-center justify-between border-t border-warm-100 mt-auto pt-4">
                        <div>
                            <span class="text-[11px] text-warm-500 block">推薦價格</span>
                            <span class="text-base font-bold text-warm-800">${snack.price}</span>
                        </div>
                        <a href="${snack.shopUrl}" target="_blank" rel="noopener noreferrer" 
                           class="px-3.5 py-2 bg-warm-600 hover:bg-warm-700 text-white text-xs sm:text-sm font-medium rounded-xl shadow-sm hover:shadow transition-all flex items-center gap-1.5 active:scale-95">
                            <span>前往賣場購物</span>
                            <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                        </a>
                    </div>
                </div>
            `).join('');
        }

        // 渲染好物開箱列表
        function renderReviews(reviews) {
            const container = document.getElementById('review-list');
            container.innerHTML = reviews.map(item => `
                <article class="bg-white rounded-3xl overflow-hidden border border-warm-200/80 shadow-sm hover:shadow-md transition-all duration-300 grid grid-cols-1 lg:grid-cols-12">
                    <!-- 封面圖 -->
                    <div class="lg:col-span-5 relative min-h-[240px] lg:min-h-full overflow-hidden">
                        <img src="${item.image}" alt="${item.title}" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" loading="lazy" onerror="this.src='https://placehold.co/800x600/EBE3D5/736043?text=Product+Review'">
                        <span class="absolute top-4 left-4 bg-warm-600 text-white text-xs px-3 py-1 rounded-full font-medium shadow-sm">
                            ${item.tag}
                        </span>
                    </div>

                    <!-- 開箱內文 -->
                    <div class="lg:col-span-7 p-6 sm:p-8 flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between text-xs text-warm-500 mb-2">
                                <span><i class="fa-regular fa-calendar me-1"></i> ${item.date}</span>
                                ${renderStars(item.score)}
                            </div>
                            
                            <h3 class="text-xl sm:text-2xl font-bold text-warm-800 mb-3 hover:text-warm-600 transition-colors">
                                ${item.title}
                            </h3>

                            <p class="text-warm-600 text-sm leading-relaxed mb-6">
                                ${item.excerpt}
                            </p>

                            <!-- 優缺點標籤 -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6 bg-warm-50/70 p-4 rounded-2xl border border-warm-200/50">
                                <div>
                                    <span class="text-xs font-bold text-emerald-700 flex items-center gap-1 mb-1.5">
                                        <i class="fa-solid fa-circle-check"></i> 優點實測
                                    </span>
                                    <ul class="text-xs text-warm-700 space-y-1">
                                        ${item.pros.map(p => `<li class="flex items-start gap-1"><span>•</span> <span>${p}</span></li>`).join('')}
                                    </ul>
                                </div>
                                <div>
                                    <span class="text-xs font-bold text-amber-700 flex items-center gap-1 mb-1.5">
                                        <i class="fa-solid fa-circle-info"></i> 選購建議
                                    </span>
                                    <ul class="text-xs text-warm-700 space-y-1">
                                        ${item.cons.map(c => `<li class="flex items-start gap-1"><span>•</span> <span>${c}</span></li>`).join('')}
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <!-- 導流按鈕區 -->
                        <div class="flex items-center justify-between pt-4 border-t border-warm-100">
                            <span class="text-xs text-warm-500 font-medium">實測總評分：<strong class="text-warm-800 text-sm">${item.score} / 5.0</strong></span>
                            <a href="${item.shopUrl}" target="_blank" rel="noopener noreferrer" 
                               class="px-5 py-2.5 bg-warm-800 hover:bg-warm-700 text-white text-xs sm:text-sm font-medium rounded-xl shadow-md transition-all flex items-center gap-2 active:scale-95">
                                <i class="fa-solid fa-bag-shopping"></i>
                                <span>前往賣場購物</span>
                            </a>
                        </div>
                    </div>
                </article>
            `).join('');
        }

        // --- 4. 篩選與搜尋互動邏輯 ---
        let currentCategory = 'all';
        let searchQuery = '';

        function filterSnacks() {
            let filtered = snacksData;

            if (currentCategory !== 'all') {
                filtered = filtered.filter(item => item.category === currentCategory);
            }

            if (searchQuery.trim() !== '') {
                const query = searchQuery.toLowerCase();
                filtered = filtered.filter(item => 
                    item.name.toLowerCase().includes(query) || 
                    item.description.toLowerCase().includes(query)
                );
            }

            renderSnacks(filtered);
        }

        // 初始化與監聽
        document.addEventListener('DOMContentLoaded', () => {
            renderSnacks(snacksData);
            renderReviews(reviewsData);

            // 分類按鈕
            const catButtons = document.querySelectorAll('#snack-categories .cat-btn');
            catButtons.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    catButtons.forEach(b => {
                        b.classList.remove('bg-warm-600', 'text-white');
                        b.classList.add('bg-white', 'text-warm-700', 'hover:bg-warm-100');
                    });
                    
                    e.currentTarget.classList.remove('bg-white', 'text-warm-700', 'hover:bg-warm-100');
                    e.currentTarget.classList.add('bg-warm-600', 'text-white');

                    currentCategory = e.currentTarget.getAttribute('data-cat');
                    filterSnacks();
                });
            });

            // 搜尋框輸入
            const searchInput = document.getElementById('snack-search');
            searchInput.addEventListener('input', (e) => {
                searchQuery = e.target.value;
                filterSnacks();
            });

            // 手機版 Toggle
            const mobileMenuBtn = document.getElementById('mobile-menu-btn');
            const mobileMenu = document.getElementById('mobile-menu');
            const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

            mobileMenuBtn.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });

            mobileNavLinks.forEach(link => {
                link.addEventListener('click', () => {
                    mobileMenu.classList.add('hidden');
                });
            });
        });
    </script>
</body>
</html>
